# Mode lokal. Lebih aman: kosongkan ini, simpan tautan di file di luar repo.
LMS_TOKEN=
# LMS_TOKEN_FILE=~/.lms-mcp/token

# Opsional. Default: folder Downloads/lms-mcp
# LMS_DOWNLOAD_DIR=

# Opsional. Isi 1 untuk menyalakan fitur mengumpulkan tugas.
# LMS_ENABLE_WRITE=
# Opsional. Folder asal file tugas, dipisah koma. Default: Documents, Downloads, Desktop
# LMS_UPLOAD_DIRS=
# Opsional. Catatan unduh/unggah. Default: ~/.lms-mcp/audit.log
# LMS_AUDIT_LOG=

# Mode online (lms-mcp serve --http). Isi di pengaturan hosting, bukan di sini.
# LMS_PUBLIC_URL=https://nama-server.up.railway.app
# LMS_SERVER_SECRET=
# LMS_EXTRA_REDIRECT_HOSTS=
# LMS_ENABLE_WRITE=
# Opsional. Naikkan lalu restart untuk memutus semua login lama. Harus satu proses HTTP.
# LMS_TOKEN_GENERATION=0
